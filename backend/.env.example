# For running the backend directly on the host (npm run start:dev) against
# the dockerized Postgres. Copy to backend/.env.
# When running the backend itself via docker compose, use the root .env.example
# instead (DB_HOST there is the service name "postgres").

PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=celesnity
DB_PASSWORD=celesnity
DB_NAME=celesnity
