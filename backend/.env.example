# For running the backend directly on the host (npm run start:dev) against
# the dockerized Postgres. Copy to backend/.env.
# When running the backend itself via docker compose, use the root .env.example
# instead (DB_HOST there is the service name "postgres").

PORT=3001

# Host-side port is 5433 (docker-compose.yml maps "5433:5432" so the
# container's internal 5432 doesn't clash with a native Postgres on the host).
DB_HOST=localhost
DB_PORT=5433
DB_USER=celesnity
DB_PASSWORD=celesnity
DB_NAME=celesnity

# Prisma CLI reads a single connection string (used by `prisma migrate dev`,
# `prisma studio`, etc. run directly on the host) — must stay in sync with
# the DB_* values above.
DATABASE_URL=postgresql://celesnity:celesnity@localhost:5433/celesnity

# Step 6: "Application API" collector target. Host-side port is 4100
# (docker-compose.yml maps "4100:4000"), matching the 5433 Postgres pattern
# above. Dev-only fixture secret, not a real credential.
FIXTURE_API_BASE_URL=http://localhost:4100
FIXTURE_API_KEY=fixture-secret-key

# Step 7: "Production Database" collector credential. Host-side port is
# 5434 (docker-compose.yml maps "5434:5432") — a Source registered via
# POST /sources for this fixture should use host "localhost", port 5434
# when the backend itself runs directly on the host (not in Docker).
# Dev-only fixture credential, not a real one.
PRODUCTION_DB_PASSWORD=prod-db-secret-password
