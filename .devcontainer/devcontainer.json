{
  "name": "Celesnity Factory Platform",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3001, 3000],
  "portsAttributes": {
    "3001": {
      "label": "Backend API",
      "visibility": "private"
    },
    "3000": {
      "label": "Frontend",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
