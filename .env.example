# Copy this file to .env and adjust values for local development.
# docker-compose reads this file automatically from the project root.

# --- Database (Postgres) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=celesnity
DB_PASSWORD=celesnity
DB_NAME=celesnity

# --- Backend (NestJS) ---
PORT=3001

# --- fixture-api (Step 6, mock "Application API") ---
# Dev-only fixture secret, not a real credential — safe to commit as a
# default. FIXTURE_FAULT_MODE: none | 500-once | 500-always | timeout.
FIXTURE_API_KEY=fixture-secret-key
FIXTURE_FAULT_MODE=none

# --- production-db (Step 7, "Production Database" fixture) ---
# Dev-only fixture credential, not a real one — safe to commit as a
# default. PRODUCTION_DB_USER/PRODUCTION_DB_NAME only matter if you want
# to override the postgres container's own defaults; the backend service
# only needs PRODUCTION_DB_PASSWORD (it reads host/port/database/user from
# each Source's own config, registered via POST /sources).
PRODUCTION_DB_USER=prod_reader
PRODUCTION_DB_PASSWORD=prod-db-secret-password
PRODUCTION_DB_NAME=production

# --- Backend: Production Lines freshness (Step 10) ---
# Minutes since a batch's latest ACCEPTED eventTime before it's STALE.
STALE_THRESHOLD_MINUTES=15

# --- Frontend (Next.js) ---
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:3001
