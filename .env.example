# Copy this file to .env and adjust values for local development.
# docker-compose reads this file automatically from the project root.

# --- Database (Postgres) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=celesnity
DB_PASSWORD=celesnity
DB_NAME=celesnity

# --- Backend (NestJS) ---
PORT=3001

# --- fixture-api (Step 6, mock "Application API") ---
# Dev-only fixture secret, not a real credential — safe to commit as a
# default. FIXTURE_FAULT_MODE: none | 500-once | 500-always | timeout.
FIXTURE_API_KEY=fixture-secret-key
FIXTURE_FAULT_MODE=none

# --- Frontend (Next.js) ---
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:3001
